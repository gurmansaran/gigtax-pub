{
  "expo": {
    "name": "gigtax",
    "slug": "gigtax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gigtax",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saran.gigtax",
      "associatedDomains": [
        "applinks:gigtaxus.com",
        "applinks:www.gigtaxus.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "GigTax needs your location to track mileage.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GigTax tracks mileage in the background so you can use other apps.",
        "NSLocationAlwaysUsageDescription": "GigTax tracks mileage in the background.",
        "NSMotionUsageDescription": "We use motion detection to auto-start tracking when you drive.",
        "NSCameraUsageDescription": "GigTax needs your camera to scan tax forms.",
        "LSApplicationQueriesSchemes": [
          "org-appextension-feature-password-management"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.saran.gigtax"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GigTax to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow GigTax to scan documents."
        }
      ],
      "expo-build-properties",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "815d8431-5914-4635-868a-948b6fc79a0e"
      }
    },
    "owner": "gurmansaran1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/815d8431-5914-4635-868a-948b6fc79a0e"
    }
  }
}